# Root env (copy as needed)
# Web (Next.js): copy relevant keys to web/.env.local
# Worker (Python): copy relevant keys to worker/.env

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=artifacts

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Chat/LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# Providers
# Text-to-Image: default to Nano Banana for single-object concepts
T2I_PROVIDER=nano
# Optional: override resolved model (defaults to fal-ai/nano-banana)
# FAL_MODEL_ID=fal-ai/nano-banana
## T2I defaults & tuning (optional)
# T2I_DEFAULT_STYLE=organic
# T2I_SYSTEM_PREFIX="a single product concept and one object, centered, neutral seamless background, product-render aesthetic, telephoto feel; no props, no people"
# T2I_SYSTEM_LIGHTING="soft three-point studio light; daylight ~5600K; soft shadow; controlled reflections"
# T2I_SYSTEM_PRINTABILITY="single solid object; features ≥1.6 mm; soft fillets/chamfers; minimize extreme overhangs; upright orientation"
# T2I_SYSTEM_SURFACE="smooth continuous surfaces; organic curvature; avoid outlines, wireframes, contour lines, hatching, cross-section marks, technical drawing cues"
# T2I_SYSTEM_MECHANICAL="hard-surface industrial look; matte gray PLA-like plastic; crisp chamfers/fillets; minimal panel seams; front three-quarter angle"
# T2I_SYSTEM_FIGURINE="standing figure on a simple round base; neutral pose; three-quarter angle; gentle rim light; smooth surfaces"
# T2I_SYSTEM_ORGANIC="single smooth form; continuous surfaces; subtle curvature; minimal fine texture; no grooves or seam lines; three-quarter angle"
# T2I_NEGATIVE="wireframe, line art, outlines, contour lines, hatching, cross-hatching, sketch, sticker, decals, blueprint, technical drawing, exploded view, cutaway, grid, panel, multi view, text, logo, watermark, people, hands, props"
# T2I_NEGATIVE_EXTRA=""

# Edit provider: Nano Banana edit
EDIT_PROVIDER=fal_nano
EDIT_MODEL_ID=fal-ai/nano-banana/edit

# I→3D provider (Trellis)
I23D_PROVIDER=fal_trellis
# I23D_API_KEY=  # unused for Trellis
# MESHY_API_KEY=  # Meshy disabled; Trellis-only
FAL_KEY=
FAL_IMAGE_SIZE=square_hd
FAL_STEPS=28
FAL_CFG=3.5
FAL_BASE_URL=https://fal.run
FAL_TRELLIS_MODEL=fal-ai/trellis/multi

# Web-side materialize fallback (optional): if enabled and FAL_KEY is set,
# the Next.js API will call Trellis directly to attach a raw mesh immediately
# instead of waiting for the Python worker. Default OFF to avoid duplicates.
WEB_I23D_FALLBACK=0

# Optional LLM/Context knobs
# LLM_VISION=0
# CONTEXT_MAX_IMAGES=4
# SIGNED_URL_TTL_S=900
# MAX_EDIT_VARIANTS=2

# Worker/pricing
PRICING_BASE_FEE_CENTS=500
PRICING_PER_GRAM_CENTS=5
PRICING_PER_HOUR_CENTS=1500

# Bambu Studio
BAMBUSTUDIO_PROFILE_PATH=/absolute/path/to/x1c_pla_profile.3mf
# BAMBU_STUDIO_CLI=/usr/bin/BambuStudio
## Recommended: Uptodate snapshot (flattened settings.json exported from a golden 3MF)
# BAMBUSTUDIO_UPTODATE_SETTINGS_PATH=/absolute/path/to/settings_uptodate.json
## Alternative: JSON presets (machine/process + filament)
# BAMBUSTUDIO_SETTINGS_PATH=/abs/machine.json;/abs/process.json
# BAMBUSTUDIO_FILAMENTS_PATH=/abs/filament.json

## Optional: density fallback for grams-from-length when slicer reports 0 g
# FILAMENT_DENSITY_G_CM3=1.24
 


# Repair & Build volume
REPAIR_SOLIDIFY=1
REPAIR_SOLIDIFY_THICKNESS_MM=1.6
BUILD_VOLUME_X_MM=256
BUILD_VOLUME_Y_MM=256
BUILD_VOLUME_Z_MM=256
BUILD_VOLUME_MARGIN_MM=2

# Default target size for small models (mm on longest side). Worker scales up during repair.
DEFAULT_MODEL_MAX_DIM_MM=120

# Image generation guidance (prefix injected before user prompt)
# Tune these to bias outputs for 3D-friendly references.
# T2I_SYSTEM_PREFIX="single object, centered on a plain neutral background; turntable-style view suitable for 3D modeling; sharp focus; high-contrast edges; even diffuse studio lighting; clean silhouette; realistic proportions; no text, no watermark, no humans, no hands, no extra props"
# T2I_SYSTEM_LIGHTING="three-point studio lighting with a soft key at 45 degrees, gentle fill, and subtle rim/back light; neutral 18% gray background; daylight white balance ~5600K; soft shadows; avoid harsh speculars, color casts, and blown highlights"
# T2I_SYSTEM_MECHANICAL="orthographic look, hard-surface product render, matte gray PLA plastic, minimal perspective, front three-quarter angle, crisp edges"
# T2I_SYSTEM_FIGURINE="full-body, balanced standing pose, simple base/pedestal, gentle rim light, three-quarter angle"
# T2I_SYSTEM_ORGANIC="single subject, three-quarter angle, soft shading, smooth surfaces, minimal background detail"
