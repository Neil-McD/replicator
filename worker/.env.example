# Supabase REST base URL (HTTPS)
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=artifacts
# Temporary rollout escape hatch only. Keep off after the lifecycle RPC migration is applied.
LIFECYCLE_DIRECT_STATUS_FALLBACK=0

# Meshy (unused; Trellis-only)
# MESHY_API_KEY=

# FAL (for T2I or I->3D providers)
FAL_KEY=
FAL_BASE_URL=https://fal.run
FAL_TRELLIS_MODEL=fal-ai/trellis/multi
I23D_PROVIDER=fal_trellis
# Image→3D timeboxing (seconds). Fast window shows a quick proxy model if exceeded.
# I23D_FAST_TIMEOUT_S=120
# I23D_TIMEOUT_S=900

# Optional OpenAI (for LLM orchestration on server-side tools)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Bambu Studio (optional initially)
BAMBUSTUDIO_PROFILE_PATH=/home/you/replicator/profiles/x1c_pla_024.3mf
# If CLI not in PATH, set full path (otherwise omit)
# BAMBU_STUDIO_CLI=/usr/bin/BambuStudio

# Uptodate snapshot (recommended): flattened settings.json exported from a golden 3MF
# BAMBUSTUDIO_UPTODATE_SETTINGS_PATH=/mnt/c/slicing/presets/settings.json
# You can chain multiple JSONs with ';' or ',' (e.g., snapshot + tiny overlay to pin variant/nozzle)
# BAMBUSTUDIO_UPTODATE_SETTINGS_PATH="/mnt/c/slicing/presets/settings.json;/mnt/c/slicing/presets/variant_overlay.json"

# WSL bridging (call Windows CLI from Ubuntu/WSL)
# Point to the Windows EXE via /mnt/c and choose a shared folder on C: for inputs/outputs
# BAMBU_STUDIO_CLI="/mnt/c/Program Files/Bambu Studio/BambuStudio.exe"
# WIN_OUT_DIR=/mnt/c/PrintJobs

# JSON preset mode (alternative to settings-3MF)
# Provide the machine/process presets (semicolon or comma separated) and a filament preset JSON.
# Example (Windows paths mapped via /mnt/c for WSL):
# BAMBUSTUDIO_SETTINGS_PATH="/mnt/c/bambu/x1c_machine.json;/mnt/c/bambu/pla_024.json"
# BAMBUSTUDIO_FILAMENTS_PATH="/mnt/c/bambu/pla_filament.json"

# Pricing
PRICING_BASE_FEE_CENTS=500
PRICING_PER_GRAM_CENTS=5
PRICING_PER_HOUR_CENTS=1500

# Optional: density fallback when slicer reports 0 g
# FILAMENT_DENSITY_G_CM3=1.24


# Repair options
REPAIR_SOLIDIFY=1
REPAIR_SOLIDIFY_THICKNESS_MM=1.6

# Geometry hygiene
# Trim a tiny slice off the base (mm) to guarantee a full first layer.
# Set 0 to disable.
AUTO_BASE_TRIM_MM=0.3

# Build volume (mm)
BUILD_VOLUME_X_MM=256
BUILD_VOLUME_Y_MM=256
BUILD_VOLUME_Z_MM=256
BUILD_VOLUME_MARGIN_MM=2

# Default max model size (mm) for generated/converted meshes.
# If a model is smaller than this on its longest dimension, the worker will scale it up
# (then clamp to build volume) during repair/orientation. Set to 0 to disable.
DEFAULT_MODEL_MAX_DIM_MM=120
