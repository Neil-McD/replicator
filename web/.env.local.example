# Public (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Toggle Operator tab
NEXT_PUBLIC_SHOW_OPERATOR=1

# Server-only (never NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=artifacts

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Providers
# T2I provider routing (default: stub). Options: stub|fal|nano
# Use 'nano' with FAL_MODEL_ID=fal-ai/nano-banana/generate for Nano Banana concepts
T2I_PROVIDER=nano
# FAL config (generic). Set model to Nano Banana or another FAL model.
FAL_KEY=your_fal_api_key
FAL_MODEL_ID=fal-ai/nano-banana/generate
# Optional: improve visual quality / consistency
# FAL_IMAGE_SIZE=square_hd
# FAL_STEPS=28
# FAL_CFG=3.5
# FAL_SEED=1234
# Optional: enable angle variety (makes N single-image calls with angle hints)
# T2I_VARIETY_MODE=angles
# or legacy flag: FAL_MULTIANGLE_VARIETY=1
# Optional tuning
# FAL_IMAGE_SIZE=square_hd
# FAL_STEPS=28
# FAL_CFG=3.5

# Edit variants cap (safety against model over-return). Default 2.
MAX_EDIT_VARIANTS=2

# Image generation guidance (prefix injected before user prompt)
# Simple, low-friction printability bias (enabled by default in code):
T2I_SYSTEM_PRINTABILITY="single solid object; firmly attached to a flat base or simple round pedestal (no gap/levitation); chunky features with soft fillets; visible contact shadow on ground plane; no thin or floating parts"
# Strong negative cue to avoid multi-object scenes (optional; code has a sensible default):
# T2I_NEGATIVE="multiple objects, set of objects, collection, assortment, group, crowded, duplicates, several items, pile, arrangement, collage, grid, split view, multi view, multi-angle, exploded view, cutaway, blueprint, diagram, text, logo, watermark, people, hands, props"
# Optional additional guidance (leave commented to keep it simple):
# T2I_SYSTEM_PREFIX="single hero object, centered and fully in-frame; neutral mid-gray seamless background; clean silhouette; product-render look; minimal perspective distortion; no text, no logos, no watermark, no humans or hands, no props"
# T2I_SYSTEM_LIGHTING="three-point studio lighting (soft key at 45°, gentle fill, subtle rim for edge separation); daylight ~5600K; soft ground-plane shadow; controlled reflections; avoid harsh speculars and color casts"
# T2I_SYSTEM_MECHANICAL="orthographic feel; hard-surface cues; matte gray PLA finish; crisp edges with soft fillets; visible split-line seam ok; front three-quarter angle"
# T2I_SYSTEM_FIGURINE="full-body, relaxed neutral pose; simple round base/pedestal; three-quarter angle; gentle rim light; smooth surfaces; no weapons or IP"
# T2I_SYSTEM_ORGANIC="single subject; smooth continuous forms; subtle curvature; three-quarter angle; minimal fine texture"

# LLM Orchestrator (server-only)
# Do not prefix with NEXT_PUBLIC
OPENAI_API_KEY=sk-...
# Recommended default model for tool use
OPENAI_MODEL=gpt-5-2025-08-07
# Optional: point to a custom API base (leave unset for api.openai.com)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Multimodal/Context settings (opt-in)
# Enable attaching candidate images + STL preview to the LLM context (vision models only)
LLM_VISION=0
# Max images to attach to vision context
CONTEXT_MAX_IMAGES=4
# Signed URL lifetime for attachments (seconds)
SIGNED_URL_TTL_S=900
